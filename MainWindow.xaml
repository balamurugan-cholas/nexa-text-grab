<Window x:Class="NexaTextGrab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nexa Text Grab" Icon="NexaTextGrab.ico" SizeToContent="Height" Height="600" Width="900" MinHeight="0" MinWidth="820" MaxHeight="760" WindowStartupLocation="CenterScreen" Background="#F8F9F8" FontFamily="Segoe UI" Foreground="#1B2620" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Margin="38,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,0,0,0">
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Copy text from your screen" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="Choose an area to recognize." FontSize="12" Foreground="#738078"/></StackPanel><Border Grid.Column="1" VerticalAlignment="Top" Background="White" BorderBrush="#E3E8E4" BorderThickness="1" CornerRadius="16" Padding="10,6"><TextBlock x:Name="StatusLabel" Text="Checking OCR…" FontSize="10"/></Border></Grid>
   <Border Background="#173D32" CornerRadius="12" Padding="18" Margin="0,20,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Press shortcut, then drag to select." Foreground="White" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Select" Padding="13,8" Click="SelectButton_Click"/></Grid></Border>
   <Border Background="White" BorderBrush="#E3E8E4" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Shortcut" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#F4F6F4" BorderBrush="#E1E6E2" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,6,0"><TextBlock Text="Ctrl" FontSize="12"/></Border><Border Background="#F4F6F4" BorderBrush="#E1E6E2" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,6,0"><TextBlock Text="Shift" FontSize="12"/></Border><ComboBox x:Name="HotkeyKeyBox" Width="82" Height="32" VerticalContentAlignment="Center" SelectionChanged="HotkeyKeyBox_SelectionChanged"/></StackPanel></Grid></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="White" BorderBrush="#E3E8E4" BorderThickness="1" CornerRadius="11" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="OCR language" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><ComboBox Grid.Row="1" x:Name="LanguageBox" Width="145" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="LanguageBox_SelectionChanged"/></Grid></Border>
    <Border Grid.Column="2" Background="White" BorderBrush="#E3E8E4" BorderThickness="1" CornerRadius="11" Padding="15"><StackPanel><TextBlock Text="Copy format" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><RadioButton x:Name="LinesModeRadio" GroupName="CopyMode" Content="Separate lines" Checked="CopyMode_Changed" Margin="0,0,0,8"/><RadioButton x:Name="BlockModeRadio" GroupName="CopyMode" Content="One text block" Checked="CopyMode_Changed"/></StackPanel></Border>
    <Border Grid.Column="4" Background="White" BorderBrush="#E3E8E4" BorderThickness="1" CornerRadius="11" Padding="15"><StackPanel><TextBlock Text="Startup" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><CheckBox x:Name="StartupCheckBox" Content="Launch at sign-in" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/></StackPanel></Border>
   </Grid>
   <TextBlock x:Name="QuickGuideHotkey" Text="Ctrl + Shift + Alt + Space: freeform  ·  Ctrl + Shift + Space: rectangle  ·  Ctrl + Shift + 1: four corners" FontSize="10" Foreground="#738078" Margin="2,12,0,0"/>
   <TextBlock Text="For best results, rotate sideways images upright before selecting." FontSize="10" Foreground="#738078" Margin="2,6,0,0"/>
  </StackPanel>
 </Grid>
</Window>
